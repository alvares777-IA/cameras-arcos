BACKEND_HOST=0.0.0.0

BACKEND_PORT=8000

CONTINUOUS_RECORDING_ENABLED=false

DATABASE_URL=postgresql+asyncpg://cameras:cameras123@postgres:5432/cameras_db

FACE_RECOGNITION_ENABLED=false

# Valor original no código: 30 | Sugerido: 10 | Reduz uso de RAM do player (back buffer menor)
HLS_BACK_BUFFER_LENGTH=10

# Valor original no código: 10 | Sugerido: 15-20 | Player tolera mais atraso antes de reconectar
HLS_LIVE_MAX_LATENCY_DURATION=20

# Valor original no código: 3 | Sugerido: 5-8 | Distância mínima do edge; valor maior = mais estável
HLS_LIVE_SYNC_DURATION=7

# Valor original no código: true | Sugerido: false | false desativa LL-HLS no cliente (menos requisições HTTP)
HLS_LOW_LATENCY_MODE=false

# Valor original no código: 5 | Não alterado | Tentativas automáticas antes de exibir erro no player
HLS_MAX_AUTO_RETRIES=5

# Valor original no código: 10 | Sugerido: 20-30 | Buffer maior reduz reconexões frequentes
HLS_MAX_BUFFER_LENGTH=30

# Valor original no código: 3000ms | Delay base do backoff exponencial (3000→6000→12000→... máx 30000ms)
HLS_RETRY_DELAY_MS=6000

MEDIAMTX_HLS_URL=http://localhost:8888

MEDIAMTX_URL=http://mediamtx:9997

MOTION_BLUR_KERNEL=21

MOTION_PIXEL_THRESHOLD=25

MOTION_THRESHOLD_PCT=1.5

# Valor atual: false | false=MediaMTX só processa segmentos HLS quando há cliente assistindo (maior economia de CPU); true=processa sempre independente de haver clientes
MTX_HLS_ALWAYS_REMUX=false

# Valor original no código: 200ms | Relevante apenas com MTX_HLS_VARIANT=fmp4 (LL-HLS); ignorado no modo mpegts
MTX_HLS_PART_DURATION=1s

# Valor original no código: 1s | Sugerido: 4-6s | Segmentos maiores = menos requisições HTTP por câmera
MTX_HLS_SEGMENT_DURATION=6s

# fmp4 ou mpegts
MTX_HLS_VARIANT=fmp4

# Valor atual: 512 | Padrão MediaMTX: 2048 | Tamanho do buffer de leitura RTSP por câmera; valores menores reduzem uso de RAM
MTX_READ_BUFFER_COUNT=512

# Valor atual: true | true=MediaMTX conecta à câmera RTSP apenas quando há browser assistindo (economia de CPU/rede); false=mantém conectado sempre
MTX_SOURCE_ON_DEMAND=true

POSTGRES_DB=cameras_db

POSTGRES_PASSWORD=cameras123

POSTGRES_USER=cameras

RECORDINGS_PATH=/recordings

RECORDING_ENABLED=false

RETENTION_DAYS=30

