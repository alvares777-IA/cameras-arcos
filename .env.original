# ============================================
# Configuração do Sistema de Câmeras
# ============================================ 

POSTGRES_USER=cameras
POSTGRES_PASSWORD=cameras123
POSTGRES_DB=cameras_db
DATABASE_URL=postgresql+asyncpg://cameras:cameras123@postgres:5432/cameras_db

RECORDINGS_PATH=/recordings
RETENTION_DAYS=30
SEGMENT_DURATION_SECONDS=300

MEDIAMTX_URL=http://mediamtx:9997
MEDIAMTX_HLS_URL=http://localhost:8888

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

RECORDING_ENABLED=false
FACE_RECOGNITION_ENABLED=false
CONTINUOUS_RECORDING_ENABLED=false

VITE_API_URL=http://localhost:8000
VITE_HLS_BASE_URL=http://localhost:8888

# Detecção de Movimento
MOTION_THRESHOLD_PCT=1.5
MOTION_PIXEL_THRESHOLD=25
MOTION_BLUR_KERNEL=21

# HLS.js Frontend Config (player no browser - tópico 2 e 4)
HLS_LOW_LATENCY_MODE=true
HLS_MAX_BUFFER_LENGTH=10
HLS_BACK_BUFFER_LENGTH=30
HLS_LIVE_SYNC_DURATION=3
HLS_LIVE_MAX_LATENCY_DURATION=10

# HLS.js Retry Config (tópico 6 - backoff exponencial)
HLS_MAX_AUTO_RETRIES=5
HLS_RETRY_DELAY_MS=3000

# MediaMTX HLS Config (tópico 3 e 4 - aplicado via API sem restart)
MTX_HLS_SEGMENT_DURATION=1s
MTX_HLS_PART_DURATION=200ms
MTX_HLS_VARIANT=fmp4
